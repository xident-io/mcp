[
  {
    "name": "xident_search_docs",
    "title": "Search Xident API",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "Keywords, e.g. 'init token' or 'webhook' or 'result'"
        },
        "limit": {
          "description": "Max results (default 10)",
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "xident_get_endpoint",
    "title": "Get Xident endpoint schema",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Exact path, e.g. /verify/v1/init"
        },
        "method": {
          "type": "string",
          "minLength": 3,
          "description": "HTTP method, e.g. POST"
        }
      },
      "required": [
        "path",
        "method"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "xident_verify_webhook_signature",
    "title": "Verify a Xident webhook signature",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "raw_body": {
          "type": "string",
          "description": "The raw request body, byte-for-byte as received"
        },
        "signature_header": {
          "type": "string",
          "description": "The X-Xident-Signature header value, e.g. t=1754000000,v1=abc..."
        },
        "secret": {
          "type": "string",
          "description": "The webhook signing secret"
        },
        "tolerance_seconds": {
          "description": "Replay window (default 300)",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "raw_body",
        "signature_header",
        "secret"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "xident_whoami",
    "title": "Check the configured Xident credential",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_start_test_verification",
    "title": "Start a sandbox verification",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "min_age": {
          "description": "Required for age_verification: a whole number from 12 to 25. Xident rounds it up to the next of 12, 15, 18, 21 or 25 and enforces that band, so 19 is enforced as 21. Leave it out for id_verification.",
          "type": "integer",
          "minimum": 12,
          "maximum": 25
        },
        "purpose": {
          "description": "age_verification (default) or id_verification. An id_verification always needs a document and a face match, and takes no min_age.",
          "type": "string",
          "enum": [
            "age_verification",
            "id_verification"
          ]
        },
        "verification_mode": {
          "description": "auto (default), document (an ID document and a face match are always required), or facial (on-device only, never a document). facial cannot be combined with purpose id_verification, which always needs a document.",
          "type": "string",
          "enum": [
            "auto",
            "document",
            "facial"
          ]
        },
        "callback_url": {
          "type": "string",
          "format": "uri",
          "description": "REQUIRED. Where the widget returns the user: HTTPS, or http://localhost in development"
        },
        "user_id": {
          "description": "Your identifier for the test person. It comes back on the callback and in the result. Leave it out and the tool generates mcp-dev-<random>. End it with +fail to make the test session fail.",
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "description": "BCP-47 locale, e.g. de-DE",
          "type": "string"
        }
      },
      "required": [
        "callback_url"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_get_result",
    "title": "Read a verification result",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "The verification token, e.g. xtk_..."
        }
      },
      "required": [
        "token"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_explain_session",
    "title": "Explain why a verification did not pass",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "token": {
          "description": "A verification token to look up",
          "type": "string"
        },
        "reason": {
          "description": "A reason code, if you already have one",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_simulate_webhook",
    "title": "Send a signed test webhook",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Target URL — must be localhost or 127.0.0.1"
        },
        "secret": {
          "type": "string",
          "description": "The webhook signing secret your handler expects"
        },
        "event": {
          "type": "string",
          "enum": [
            "session.success",
            "session.failed",
            "session.canceled"
          ],
          "description": "Which lifecycle event to simulate. session.expired exists in the catalog but is never emitted in production, so it is not offered here."
        }
      },
      "required": [
        "url",
        "secret",
        "event"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_check_integration",
    "title": "Lint a Xident integration",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
]
