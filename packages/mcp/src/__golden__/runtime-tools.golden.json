[
  {
    "name": "xident_get_verification_result",
    "scope": "verification:read",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "The verification token, e.g. xtk_..."
        }
      },
      "required": [
        "token"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_start_verification",
    "scope": "verification:write",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "min_age": {
          "description": "Required for age_verification: a whole number from 12 to 25. Xident rounds it up to the next of 12, 15, 18, 21 or 25 and enforces that band, so 19 is enforced as 21. Leave it out for id_verification.",
          "type": "integer",
          "minimum": 12,
          "maximum": 25
        },
        "purpose": {
          "description": "age_verification (default) or id_verification. An id_verification always needs a document and a face match, and takes no min_age.",
          "type": "string",
          "enum": [
            "age_verification",
            "id_verification"
          ]
        },
        "verification_mode": {
          "description": "auto (default), document (an ID document and a face match are always required), or facial (on-device only, never a document). facial cannot be combined with purpose id_verification, which always needs a document.",
          "type": "string",
          "enum": [
            "auto",
            "document",
            "facial"
          ]
        },
        "callback_url": {
          "type": "string",
          "format": "uri",
          "description": "Where the person returns after the flow"
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED. Your own identifier for the person being verified. It comes back on the callback and in the result. Must not be a Xident key or token."
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED. A stable key for this logical request. Retrying with the same key returns the same session instead of creating a second one."
        }
      },
      "required": [
        "callback_url",
        "user_id",
        "idempotency_key"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_verify_face_2fa",
    "scope": "2fa:verify",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "description": "Your identifier for the enrolled person"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Base64-encoded image of the face to check"
        }
      },
      "required": [
        "user_id",
        "image"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_list_blacklist",
    "scope": "blacklist:read",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
]
