[
  {
    "name": "xident_get_verification_result",
    "scope": "verification:read",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "The verification token, e.g. xtk_..."
        }
      },
      "required": [
        "token"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_start_verification",
    "scope": "verification:write",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "min_age": {
          "description": "Age gate, e.g. 18",
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "purpose": {
          "type": "string",
          "enum": [
            "age_verification",
            "id_verification"
          ]
        },
        "verification_mode": {
          "type": "string",
          "enum": [
            "auto",
            "document",
            "facial"
          ]
        },
        "callback_url": {
          "type": "string",
          "format": "uri",
          "description": "Where the person returns after the flow"
        },
        "user_id": {
          "description": "Your identifier for the person, echoed back",
          "type": "string"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED. A stable key for this logical request. Retrying with the same key returns the same session instead of creating a second one."
        }
      },
      "required": [
        "callback_url",
        "idempotency_key"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_verify_face_2fa",
    "scope": "2fa:verify",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "minLength": 1,
          "description": "Your identifier for the enrolled person"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "Base64-encoded image of the face to check"
        }
      },
      "required": [
        "user_id",
        "image"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "xident_list_blacklist",
    "scope": "blacklist:read",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  }
]
